
# Security headers for Netlify (and any host that honors _headers).
# Applies to every route on the deployed site.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://ncrh.laikipia.go.ke https://*.googleapis.com https://*.gstatic.com; connect-src 'self' wss://ncrh.laikipia.go.ke; frame-src https://www.google.com https://maps.google.com; child-src https://www.google.com https://maps.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
