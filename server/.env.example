
# One of: development | test | staging | production

NODE_ENV=development
PORT=5000

# MySQL (Sequelize) — required in every environment

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ncrh_dev
DB_USER=root
DB_PASSWORD=

# Optional pool/TLS tuning — safe defaults are applied if omitted.
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
DB_TIMEZONE=+00:00
# Must be "true" for staging/production; startup fails otherwise once
# NODE_ENV=production (see sequelize/config/con 
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Verbose SQL logging — leave off outside local debugging.
DB_LOGGING=false


# Auth / JWT

JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
CERTIFICATE_SIGNING_SECRET=replace-with-a-long-random-string
BCRYPT_SALT_ROUNDS=12


# Email

EMAIL_SERVICE=gmail
EMAIL_USER=replace-with-smtp-username
EMAIL_PASSWORD=replace-with-smtp-app-password
FRONTEND_URL=http://localhost:5173


# M-Pesa

MPESA_CONSUMER_KEY=replace-with-mpesa-consumer-key
MPESA_CONSUMER_SECRET=replace-with-mpesa-consumer-secret
MPESA_SHORTCODE=replace-with-mpesa-shortcode
MPESA_PASSKEY=replace-with-mpesa-passkey
MPESA_ENV=sandbox
MPESA_API_URL=https://sandbox.safaricom.co.ke
MPESA_CALLBACK_URL=https://your-public-domain.example.com/api/mpesa/callback

# Set to "true" to use real fee amounts (research submission/download fees);
# leave "false" in development so test payments use nominal amounts.
USE_PRODUCTION_AMOUNTS=false
